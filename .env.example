# Server-only HTTPS endpoint for explicit enquiries. Never commit real credentials.
LEAD_WEBHOOK_URL=

# App: off by default. `npm run app:preview` enables a loopback-only example workspace.
VILLAGE_APP_MODE=off
# A controlled pilot requires persistent disk and an exact HTTPS origin.
VILLAGE_DB_PATH=
VILLAGE_APP_ORIGIN=

# Optional direct email delivery. All three settings are private server variables.
# LEAD_TO_EMAIL is the owner's inbox. LEAD_FROM_EMAIL must be a verified sender.
# Direct email takes precedence over LEAD_WEBHOOK_URL; failed sends never fall back.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
